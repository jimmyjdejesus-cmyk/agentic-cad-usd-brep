# Google Gemini API Key for server-side Agentic CAD B-Rep synthesis & self-healing
GEMINI_API_KEY=

# Firebase Client Web Configuration (Optional - for Auth & Cloud Vault)
# If not provided, in-app local parametric CAD features function normally.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Local / Self-Hosted Inference Endpoints (Optional)
# OLLAMA_HOST=http://127.0.0.1:11434
# PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Agnostic OpenAI-Compatible Endpoints (OpenAI, Anthropic proxy, Groq, Together, vLLM, LM Studio)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_or_groq_api_key

# Hugging Face Hub API Token (Optional - increases rate limits for HF model search and enables Serverless Inference)
# HF_API_TOKEN=hf_your_token_here
