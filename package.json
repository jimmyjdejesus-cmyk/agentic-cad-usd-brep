{
  "name": "agentic-cad-usd-brep",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Agentic B-Rep CAD Studio powered by NVIDIA usd-brep (SMLib) and Gemini 3.8 Flash — Ready for Google AI Studio Two-Way GitHub Sync",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "backend": "uvicorn backend.server:app --host 127.0.0.1 --port 8000 --reload",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:visual": "node scripts/full-visual-and-frontend-test.mjs",
    "release:check": "node scripts/release-manager.mjs check",
    "release:changelog": "node scripts/release-manager.mjs changelog",
    "release:bump": "node scripts/release-manager.mjs bump",
    "issues:list": "node scripts/sync-project-issues.mjs list",
    "issues:verify": "node scripts/sync-project-issues.mjs verify",
    "issues:sync": "node scripts/sync-project-issues.mjs sync"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "express": "^5.3.0",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "manifold-3d": "^3.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
